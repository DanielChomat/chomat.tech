---
import MobileMenu from "../components/nav/MobileMenu.astro";
import NavCapsule from "../components/nav/NavCapsule.astro";
import Kicker from "../components/primitives/Kicker.astro";
import { SITE } from "../data/site.ts";
import BaseLayout from "../layouts/BaseLayout.astro";

const { notFound } = SITE;
---

<BaseLayout
    title="404 — Daniel Chomat"
    description="This URL doesn't resolve to anything I've built — yet."
>
    <NavCapsule items={notFound.nav} topHref="#main" />
    <MobileMenu items={notFound.nav} />
    <div class="page">
        <main id="main" class="page-body not-found">
                <div class="nf-glyph" aria-hidden="true">
                    <span class="nf-glyph-digit">
                        4
                        <span class="nf-glyph-shadow nf-glyph-shadow--accent">4</span>
                    </span>
                    <span class="nf-glyph-x">✕</span>
                    <span class="nf-glyph-digit">
                        4
                        <span class="nf-glyph-shadow nf-glyph-shadow--rose">4</span>
                    </span>
                </div>

                <Kicker class="nf-kicker">{notFound.kicker}</Kicker>

                <h1 class="t-heading nf-heading">
                    <span class="marker">{notFound.headingMark}</span>{notFound.headingTrail}
                </h1>

                <p class="t-body muted nf-body">{notFound.body}</p>

                <ul class="nf-cards" role="list">
                    {
                        notFound.cards.map((c) => (
                            <li>
                                <a class:list={["card", c.tint, "nf-card"]} href={c.href}>
                                    <Kicker>{c.kicker}</Kicker>
                                    <h3 class="t-title nf-card-title">{c.title}</h3>
                                    <p class="t-body muted">{c.blurb}</p>
                                </a>
                            </li>
                        ))
                    }
                </ul>

                <p class="t-mono nf-footnote">
                    {notFound.footnoteLead}<a class="accent" href={notFound.footnoteHref}
                        >{notFound.footnoteLink}</a
                    >{notFound.footnoteTrail}
                </p>
        </main>
    </div>
</BaseLayout>

<style>
    .not-found {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.5rem;
    }
    .nf-glyph {
        font-family: var(--font-mono);
        font-weight: 500;
        font-size: clamp(6rem, 28vw, 17.5rem);
        line-height: 1;
        letter-spacing: -0.04em;
        display: flex;
        align-items: baseline;
        gap: 0.25rem;

        @media (max-width: 45rem) {
            gap: 0.125rem;
        }
    }
    .nf-glyph-digit {
        position: relative;
        display: inline-block;
    }
    .nf-glyph-shadow {
        position: absolute;
        inset: 0;
        mix-blend-mode: multiply;
    }
    .nf-glyph-shadow--accent {
        color: var(--accent);
        transform: translate(0.375rem, 0.375rem);
        opacity: 0.55;
    }
    .nf-glyph-shadow--rose {
        color: var(--tint-rose);
        transform: translate(-0.3125rem, 0.25rem);
        opacity: 0.6;
    }
    .nf-glyph-x {
        color: var(--accent);
        display: inline-block;
        transform: rotate(-12deg);
        margin: 0 0.5rem;

        @media (max-width: 45rem) {
            margin: 0 0.25rem;
        }
    }
    .nf-heading {
        max-width: 35rem;
        font-size: clamp(1.5rem, 4.5vw, 2rem);
    }
    .nf-body {
        max-width: 28.75rem;
    }
    .nf-cards {
        list-style: none;
        padding: 0;
        margin: 1.125rem 0 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.75rem;
        width: 100%;
        max-width: 47.5rem;

        @media (max-width: 45rem) {
            grid-template-columns: 1fr 1fr;
            max-width: 22rem;
        }
    }
    .nf-card {
        text-align: left;
        text-decoration: none;
        color: inherit;
        gap: 0.25rem;
        transition: transform 180ms ease, box-shadow 180ms ease;
    }
    .nf-card:hover,
    .nf-card:focus-visible {
        transform: translateY(-0.125rem);
    }
    .nf-card-title {
        margin-top: 0.25rem;
    }
    .nf-footnote {
        margin-top: 0.875rem;
    }
    .nf-footnote a {
        text-decoration: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .nf-card {
            transition: none;
        }
        .nf-card:hover,
        .nf-card:focus-visible {
            transform: none;
        }
    }
</style>
