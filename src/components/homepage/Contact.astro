---
import { SITE } from "../../data/site.ts";
import HandArrow from "../primitives/HandArrow.astro";
import Kicker from "../primitives/Kicker.astro";

const { contact } = SITE;
const { github, linkedin, resume } = contact.cards;
---

<section id="contact" style="position: relative;">
    <div class="section-mark">
        <span class="lineno">{contact.number}</span>
    </div>
    <header>
        <div
            class="row"
            style="justify-content: space-between; align-items: baseline;"
        >
            <Kicker>{contact.kicker}</Kicker>
            <span class="t-mono muted">{contact.note}</span>
        </div>
        <h2 class="t-heading" style="margin-top: 0.375rem;">
            <span>{contact.headingMain}</span>{" "}
            <span class="muted">{contact.headingMuted}</span>
        </h2>
        <div style="height: 1px; background: var(--line); margin-top: 1rem;"></div>
    </header>

    <div class="bento" style="margin-top: 1.375rem;">
        <div class="col-4">
            <a
                class="card tint-sky"
                href={github.href}
                style="text-decoration: none; color: inherit; min-height: 10rem;"
            >
                <Kicker>{github.kicker}</Kicker>
                <h3 class="t-heading">{github.handle}</h3>
                <p class="t-body">{github.blurb}</p>
                <div class="card-foot">
                    <span class="t-mono">{github.foot}</span>
                    <span class="t-mono accent">↗</span>
                </div>
            </a>
        </div>
        <div class="col-4">
            <a
                class="card tint-lavender"
                href={linkedin.href}
                style="text-decoration: none; color: inherit; min-height: 10rem;"
            >
                <Kicker>{linkedin.kicker}</Kicker>
                <h3 class="t-heading">{linkedin.handle}</h3>
                <p class="t-body">{linkedin.blurb}</p>
                <div class="card-foot">
                    <span class="t-mono">{linkedin.foot}</span>
                    <span class="t-mono accent">↗</span>
                </div>
            </a>
        </div>
        <div class="col-4">
            <a
                class="card inked"
                href={resume.href}
                style="text-decoration: none; min-height: 10rem;"
            >
                <Kicker>{resume.kicker}</Kicker>
                <h3 class="t-heading">{resume.handle}</h3>
                <p class="t-body muted">{resume.blurb}</p>
                <div class="card-foot">
                    <span class="t-mono muted">{resume.foot}</span>
                    <span class="t-mono accent">↓</span>
                </div>
            </a>
        </div>
    </div>

    <ul class="wormhole-list">
        {
            contact.wormholes.map((w) => (
                <li>
                    <a class="wormhole" href={w.href}>
                        {w.label} <HandArrow size={14} />
                    </a>
                </li>
            ))
        }
    </ul>
</section>
