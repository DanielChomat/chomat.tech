---
import { SITE } from "../../data/site.ts";

const { footer } = SITE;
---

<footer class="site-footer">
    <div class="row row-between row-baseline page-footer-row">
        <span class="t-mono muted">
            {footer.copyright} · Set in <strong class="footer-strong">{footer.setIn}</strong>
            &amp; <strong class="footer-strong">{footer.setInMono}</strong> · Built with {
                footer.builtWith
            }
        </span>
        <span class="t-mono">
            <a class="back-to-top" href="#hero">{footer.backToTop}</a>
        </span>
    </div>
</footer>

<style>
    .site-footer {
        margin-top: 5rem;
        padding-top: 1.375rem;
        border-top: 1px solid var(--line);
    }
    .footer-strong {
        color: var(--text);
    }
    .back-to-top {
        color: inherit;
        text-decoration: none;
    }
</style>
