---
import { getCollection } from "astro:content";
import { SITE } from "../../data/site.ts";
import ExperienceCard from "../primitives/ExperienceCard.astro";
import HandArrow from "../primitives/HandArrow.astro";
import Kicker from "../primitives/Kicker.astro";

const { experience: copy } = SITE;

const entries = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
---

<section id="experience">
    <div class="section-mark">
        <span class="lineno">{copy.number}</span>
    </div>
    <header>
        <div class="row row-between row-baseline">
            <Kicker>{copy.kicker}</Kicker>
            <a class="t-mono accent" href={copy.link.href}>
                {copy.link.label} <HandArrow size={12} />
            </a>
        </div>
        <h2 class="t-heading section-heading">
            <span>{copy.headingMain}</span><span class="muted">{copy.headingMuted}</span>
        </h2>
        <p class="t-body muted experience-intro">
            {copy.intro}
        </p>
        <div class="section-divider"></div>
    </header>

    <div class="bento bento-pad-top">
        {
            entries.map((entry, i) => (
                <div class="col-4">
                    <ExperienceCard entry={entry} index={i} currentLabel={copy.currentLabel} />
                </div>
            ))
        }
    </div>
</section>

<style>
    .experience-intro {
        margin-top: 0.375rem;
        max-width: 36.25rem;
    }
</style>
