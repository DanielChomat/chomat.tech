---
import { getCollection, render } from "astro:content";
import { stickerClass, tintClass } from "../../data/format.ts";
import { SITE } from "../../data/site.ts";
import HandArrow from "../primitives/HandArrow.astro";
import Kicker from "../primitives/Kicker.astro";
import MiniUI from "../primitives/MiniUI.astro";
import Pill from "../primitives/Pill.astro";
import Placeholder from "../primitives/Placeholder.astro";

const { now } = SITE;

const building = (await getCollection("projects", (p) => p.data.status === "building")).sort(
    (a, b) => a.data.order - b.data.order
);

const featured = building.find((p) => p.data.bentoSize === "xl");
const smalls = building.filter((p) => p.data.bentoSize !== "xl");

if (!featured) {
    throw new Error("Now: expected a building project with bentoSize='xl' as featured.");
}

const FeaturedContent = (await render(featured)).Content;
const smallContents = await Promise.all(
    smalls.map(async (p) => ({ p, Content: (await render(p)).Content }))
);

const miniKindBySlug: Record<string, "igic" | "pregnancy"> = {
    igic: "igic",
    companion: "pregnancy",
};

const tints: Record<string, string> = {
    igic: "tint-butter",
    companion: "tint-sage",
};
---

<section id="now">
    <header>
        <div class="row row-between row-baseline">
            <div class="row row-baseline now-eyebrow">
                <span class="t-mono muted">{now.number}</span>
                <Kicker>{now.kicker}</Kicker>
            </div>
            <span class="t-mono muted">{now.count}</span>
        </div>
        <h2 class="t-heading section-heading">
            <span>{now.headingMain}</span>
            <span class="muted">{now.headingMuted}</span>
        </h2>
        <div class="section-divider"></div>
    </header>

    <article class="card stripe-bg now-featured">
        {
            featured.data.sticker && (
                <div class="featured-sticker">
                    <span class:list={["sticker", stickerClass(featured.data.sticker.tone)]}>
                        {featured.data.sticker.text}
                    </span>
                </div>
            )
        }
        <div class="now-featured-grid">
            <div>
                <Kicker>{now.featuredKicker}</Kicker>
                <h3 class="t-heading featured-title">
                    {featured.data.title}<span class="accent">.</span>
                </h3>
                <div class="t-body featured-body">
                    <FeaturedContent />
                </div>
                <ul class="row-tight featured-tech">
                    {featured.data.tech.map((t) => <li><Pill>{t}</Pill></li>)}
                </ul>
                <div class="featured-cta">
                    <a class="btn accent" href={`/projects/${featured.id}`}>
                        {now.featuredCtaLabel} <HandArrow size={14} />
                    </a>
                </div>
            </div>
            <div class="now-thumbs-grid">
                <Placeholder h={260}>home</Placeholder>
                <Placeholder h={260}>capture</Placeholder>
                <Placeholder h={260}>timeline</Placeholder>
            </div>
        </div>
    </article>

    <div class="now-small-grid">
        {
            smallContents.map(({ p, Content }) => (
                <article
                    class:list={[
                        "card",
                        "now-small",
                        tints[p.id] ?? tintClass(p.data.sticker?.tone),
                    ]}
                >
                    {p.data.sticker && (
                        <div class="now-small-sticker">
                            <span class:list={["sticker", stickerClass(p.data.sticker.tone)]}>
                                {p.data.sticker.text}
                            </span>
                        </div>
                    )}
                    <Kicker>{now.cardKickers[p.id] ?? p.data.tagline}</Kicker>
                    <h3 class="t-title">{p.data.title}</h3>
                    <div class="t-body">
                        <Content />
                    </div>
                    {miniKindBySlug[p.id] && <MiniUI kind={miniKindBySlug[p.id]} />}
                    <div class="card-foot">
                        <ul class="row-tight">
                            {p.data.tech.map((t) => (
                                <li>
                                    <Pill>{t}</Pill>
                                </li>
                            ))}
                        </ul>
                        <span class="t-mono accent">→</span>
                    </div>
                </article>
            ))
        }
    </div>
</section>

<style>
    .now-eyebrow {
        gap: 0.875rem;
    }
    .section-heading {
        margin-top: 0.375rem;
    }
    .featured-sticker {
        position: absolute;
        top: 1.5rem;
        right: 1.75rem;
    }
    .featured-title {
        margin-top: 0.375rem;
        font-size: clamp(1.75rem, 6vw, 3rem);
    }
    .featured-body {
        margin-top: 0.25rem;
        font-size: 1rem;
        max-width: 26.25rem;
    }
    .featured-tech {
        margin-top: 1.125rem;
    }
    .featured-cta {
        margin-top: 1rem;
    }
    .now-small {
        position: relative;
    }
    .now-small-sticker {
        position: absolute;
        top: 0.875rem;
        right: 0.875rem;
    }
</style>
