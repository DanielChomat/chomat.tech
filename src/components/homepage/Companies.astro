---
import { getCollection } from "astro:content";

const companies = (await getCollection("companies")).sort((a, b) => a.data.order - b.data.order);
---

<section style="margin-top: 28px;" aria-label="Companies I've worked with">
    <div class="card faintbg" style="padding: 20px 28px;">
        <ul class="logo-strip">
            {
                companies.map((c) => (
                    <li class="logo" style="height: 28px; font-size: 11px;">
                        {c.data.name}
                    </li>
                ))
            }
        </ul>
    </div>
</section>
