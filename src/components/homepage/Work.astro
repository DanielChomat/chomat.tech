---
import { getCollection } from "astro:content";
import { bentoCol, stickerClass } from "../../data/format.ts";
import { SITE } from "../../data/site.ts";
import HandArrow from "../primitives/HandArrow.astro";
import Kicker from "../primitives/Kicker.astro";
import Placeholder from "../primitives/Placeholder.astro";

const { work } = SITE;

const cards = (
    await getCollection("projects", (p) => p.data.status !== "building" && p.data.featured)
).sort((a, b) => a.data.order - b.data.order);
const TEMP_STATIC_CARDS: typeof cards = []
---

<section id="work">
    <div class="section-mark">
        <span class="lineno">{work.number}</span>
    </div>
    <header>
        <div class="row row-between row-baseline">
            <Kicker>{work.kicker}</Kicker>
            <span class="t-mono muted">{work.countNote}</span>
        </div>
        <h2 class="t-heading section-heading">
            <span>{work.headingMain}</span><span class="muted">{work.headingMuted}</span>
        </h2>
        <div class="section-divider"></div>
    </header>

    {TEMP_STATIC_CARDS.length > 0 ? (
        <div class="bento bento-pad-top">
            {TEMP_STATIC_CARDS.map((p) => {
                const isBig = ["lg", "xl"].includes(p.data.bentoSize);
                const sticker = p.data.sticker;
                return (
                    <div class={bentoCol(p.data.bentoSize)}>
                        <article class:list={["card", "work-card", isBig && "work-card-lg"]}>
                            {sticker && (
                                <div class="work-sticker">
                                    <span class:list={["sticker", stickerClass(sticker.tone)]}>
                                        {sticker.text}
                                    </span>
                                </div>
                            )}
                            <Placeholder h={isBig ? 200 : 110}>{p.data.title}</Placeholder>
                            <div class="card-head work-head">
                                <h3 class:list={["t-title", isBig && "t-title-lg"]}>
                                    {p.data.title}
                                </h3>
                                <span class="t-mono muted">{p.data.year}</span>
                            </div>
                            <p class="t-body muted">{p.data.tagline}</p>
                            <div class="card-foot">
                                <span class="t-mono">{p.data.homeLabel ?? ""}</span>
                                <span class="t-mono accent">
                                    {p.data.client} <HandArrow size={12} />
                                </span>
                            </div>
                        </article>
                    </div>
                );
            })}
        </div>
    ) : (
        <div class="card work-empty bento-pad-top">
            <h3 class="t-title work-empty-title">{work.empty.title}</h3>
            <p class="t-body muted">{work.empty.body}</p>
        </div>
    )}

    {cards.length > 0 && (
        <div class="row row-between work-footer">
            <span class="t-mono muted">{work.footerNote}</span>
            {/* "See all twelve" → /projects gallery. Disabled until the
                gallery page ships; tracking in #79. */}
            {/* <a class="btn" href={work.linkHref}>
                {work.linkLabel} <HandArrow size={14} />
            </a> */}
        </div>
    )}
</section>

<style>
    .work-card {
        position: relative;
    }
    .work-sticker {
        position: absolute;
        top: 0.875rem;
        right: 0.875rem;
        z-index: 1;
    }
    .work-head {
        margin-top: 0.375rem;
    }
    .t-title-lg {
        font-size: 1.375rem;
    }
    .work-footer {
        margin-top: 1.125rem;
    }
    .work-empty {
        gap: 0.375rem;
    }
    .work-empty-title {
        font-size: 1.375rem;
    }
</style>
