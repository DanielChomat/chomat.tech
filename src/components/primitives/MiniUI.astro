---
import Placeholder from "./Placeholder.astro";

type Props = {
    kind: "igic" | "moments" | "pregnancy";
};
const { kind } = Astro.props;
---

{
    kind === "igic" && (
        <div class="miniui miniui-igic">
            <div class="row row-between">
                <span class="muted">Net</span>
                <span>1,200.00 €</span>
            </div>
            <div class="row row-between">
                <span class="muted">IGIC 7%</span>
                <span>+84.00 €</span>
            </div>
            <div class="divider" />
            <div class="row row-between">
                <span>Gross</span>
                <span class="accent">1,284.00 €</span>
            </div>
        </div>
    )
}

{
    kind === "moments" && (
        <div class="miniui miniui-moments">
            {Array.from({ length: 6 }).map(() => (
                <Placeholder h={42} />
            ))}
        </div>
    )
}

{
    kind === "pregnancy" && (
        <div class="miniui miniui-pregnancy">
            <div class="t-mono">Week 24 / 40</div>
            <div class="miniui-progress">
                <div class="miniui-progress-fill" />
            </div>
            <div class="t-mono muted">112 days to go</div>
        </div>
    )
}

<style>
    .miniui {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
    }
    .miniui-igic,
    .miniui-pregnancy {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    .miniui-moments {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0.25rem;
    }
    .miniui-progress {
        height: 0.375rem;
        background: var(--surface-2);
        border-radius: 9999rem;
        overflow: hidden;
    }
    .miniui-progress-fill {
        width: 60%;
        height: 100%;
        background: var(--accent);
    }
</style>
