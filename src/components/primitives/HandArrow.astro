---
type Props = {
    /** Size in design-px units; rendered as rem (px / 16) so it scales with user font-size. */
    size?: number;
};
const { size = 18 } = Astro.props;
const sizeRem = `${size / 16}rem`;
---

<svg
    class="arrow"
    width={sizeRem}
    height={sizeRem}
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    focusable="false"
>
    <path
        d="M3 13 C 9 12, 14 11, 19 11"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
    />
    <path
        d="M14 6 L 19 11 L 14 16"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
    />
</svg>
