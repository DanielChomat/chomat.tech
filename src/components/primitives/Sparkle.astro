---
type Props = {
    /** Size in design-px units; rendered as rem so it scales with user font-size. */
    size?: number;
};
const { size = 14 } = Astro.props;
const sizeRem = `${size / 16}rem`;
---

<svg
    width={sizeRem}
    height={sizeRem}
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    focusable="false"
>
    <path
        d="M12 2 L12 22 M2 12 L22 12 M5 5 L19 19 M19 5 L5 19"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
    />
</svg>
