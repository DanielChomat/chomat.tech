---
type Props = {
    /** Height in design-px units; rendered as rem (px / 16). */
    h?: number;
    dark?: boolean;
    class?: string;
};
const { h = 120, dark = false, class: className = "" } = Astro.props;
const heightRem = `${h / 16}rem`;
---

<div
    class:list={["ph", dark && "dark", className]}
    style={`--ph-h: ${heightRem};`}
>
    <slot />
</div>
