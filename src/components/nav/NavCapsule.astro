---
type NavItem = { label: string; href: string };

type Props = {
    items: readonly NavItem[];
    active?: number;
};

const { items, active = -1 } = Astro.props;
---

<div class="pill-nav" data-nav-capsule>
    <a
        class="to-top"
        href="#hero"
        aria-label="Back to top"
        data-back-to-top
    >
        ↑
    </a>
    <span class="active-pill" data-active-pill aria-hidden="true"></span>
    {
        items.map((it, i) => (
            <a
                href={it.href}
                class:list={{ active: i === active }}
            >
                {it.label}
            </a>
        ))
    }
    <a class="resume-cta" href="/resume.pdf"
        >Resume<span style="margin-left: 4px; opacity: 0.7;">.pdf</span></a
    >
</div>

<script>
    const nav = document.querySelector<HTMLElement>("[data-nav-capsule]");
    if (nav) {
        const indicator = nav.querySelector<HTMLElement>("[data-active-pill]");
        const links = Array.from(
            nav.querySelectorAll<HTMLAnchorElement>(
                'a[href^="#"]:not([data-back-to-top])'
            )
        );
        const linkBySection = new Map<HTMLElement, HTMLAnchorElement>();
        for (const link of links) {
            const id = link.getAttribute("href")?.slice(1);
            if (!id) continue;
            const section = document.getElementById(id);
            if (section) linkBySection.set(section, link);
        }

        let lastActive: HTMLAnchorElement | null = null;
        let firstMove = true;

        const setActive = (next: HTMLAnchorElement | null) => {
            if (next === lastActive) return;
            for (const l of links) l.classList.remove("active");
            if (!indicator) {
                lastActive = next;
                return;
            }
            if (!next) {
                indicator.style.opacity = "0";
                lastActive = null;
                return;
            }
            next.classList.add("active");
            const move = () => {
                indicator.style.transform = `translateX(${next.offsetLeft}px)`;
                indicator.style.width = `${next.offsetWidth}px`;
                indicator.style.opacity = "1";
            };
            if (firstMove) {
                // Snap into place on first reveal — don't slide from the corner.
                indicator.style.transition = "none";
                move();
                // Force reflow, then re-enable transitions.
                void indicator.offsetWidth;
                indicator.style.transition = "";
                firstMove = false;
            } else {
                move();
            }
            lastActive = next;
        };

        const sectionLinks = Array.from(linkBySection.values());
        const visible = new Set<Element>();
        let endReached = false;

        const update = () => {
            // When the footer is visible the user has reached the end of the content —
            // force the last nav item, since a short trailing section may never reach
            // the trigger band on its own.
            if (endReached) {
                setActive(sectionLinks[sectionLinks.length - 1] ?? null);
                return;
            }
            // Otherwise: pick the bottommost section currently in the trigger band.
            let chosen: HTMLAnchorElement | null = null;
            let maxTop = Number.NEGATIVE_INFINITY;
            for (const section of visible) {
                const top = section.getBoundingClientRect().top;
                if (top > maxTop) {
                    maxTop = top;
                    chosen = linkBySection.get(section as HTMLElement) ?? null;
                }
            }
            setActive(chosen);
        };

        // Trigger band = top ~30% of the viewport. A section is "in view" when its
        // rect overlaps this band.
        const sectionObs = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) visible.add(entry.target);
                    else visible.delete(entry.target);
                }
                update();
            },
            { rootMargin: "0px 0px -70% 0px", threshold: 0 }
        );
        for (const section of linkBySection.keys()) sectionObs.observe(section);

        // End-of-content sentinel: the page footer.
        const footer = document.querySelector<HTMLElement>("footer");
        if (footer) {
            const endObs = new IntersectionObserver(
                ([entry]) => {
                    endReached = entry.isIntersecting;
                    update();
                },
                { threshold: 0 }
            );
            endObs.observe(footer);
        }

        // Back-to-top: reveal once the hero scrolls out of view.
        const toTop = nav.querySelector<HTMLAnchorElement>("[data-back-to-top]");
        const hero = document.getElementById("hero");
        if (toTop && hero) {
            const heroObs = new IntersectionObserver(
                ([entry]) => {
                    toTop.toggleAttribute("data-visible", !entry.isIntersecting);
                },
                { rootMargin: "-50px 0px 0px 0px" }
            );
            heroObs.observe(hero);
        }
    }
</script>
